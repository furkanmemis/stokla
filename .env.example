# Supabase project settings → API. Only the publishable (anon) key belongs here;
# never put the secret / service_role key in this app or in the repository.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
# Optional: fixed site address used in login e-mails (e.g. https://stokla.com.tr)
NEXT_PUBLIC_SITE_URL=
